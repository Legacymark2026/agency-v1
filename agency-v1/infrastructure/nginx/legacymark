# 1. Redirección de HTTP (Puerto 80) -> HTTPS (Puerto 443)
server {
    listen 80;
    listen [::]:80;
    server_name legacymarksas.com www.legacymarksas.com;

    # Redirige todo el tráfico HTTP a HTTPS sin www
    return 301 https://legacymarksas.com$request_uri;
}

# 2. Bloque Principal HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name legacymarksas.com www.legacymarksas.com;

    # Configuración SSL (Gestionada por Certbot)
    ssl_certificate /etc/letsencrypt/live/legacymarksas.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/legacymarksas.com/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    # Redirección interna: de www.legacymarksas.com a legacymarksas.com (HTTPS)
    if ($host = www.legacymarksas.com) {
        return 301 https://legacymarksas.com$request_uri;
    }

    # Proxy para Grafana
    location /grafana {
        proxy_pass http://localhost:3002;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy para Prometheus
    location /prometheus {
        proxy_pass http://localhost:9090;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Proxy hacia Traefik Gateway (HTTPS) en el puerto 8443
    location / {
        proxy_pass https://localhost:8443;
        proxy_ssl_name $host;
        proxy_ssl_verify off;
        proxy_ssl_server_name on;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
