# ══════════════════════════════════════════════════════════════════════════════
# LegacyMark — Example Environment Variables
# ══════════════════════════════════════════════════════════════════════════════
# WARNING: Do NOT put real secrets in this file. Copy to .env and fill in values.
# ══════════════════════════════════════════════════════════════════════════════

# ── Application ──────────────────────────────────
NODE_ENV=
NEXTAUTH_URL=

# ── Database ─────────────────────────────────────
POSTGRES_PASSWORD=
BACKUP_ENCRYPTION_KEY=

# ── Authentication ───────────────────────────────
NEXTAUTH_SECRET=
JWT_SECRET=
AUTH_SECRET=
INTERNAL_SECRET=

# ── Payments (Bold Colombia) ─────────────────────
PAYMENT_HMAC_SECRET=

# ── External APIs ────────────────────────────────
GOOGLE_GEMINI_API_KEY=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RESEND_API_KEY=

# ── Monitoring & Infra ───────────────────────────
GRAFANA_ADMIN_PASSWORD=
ACME_EMAIL=
