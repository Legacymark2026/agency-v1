# ════════════════════════════════════════════════════════════════════════
# Goldneez Coffee Web — Variables de Entorno
# ════════════════════════════════════════════════════════════════════════
# Copia este archivo como .env.local (local) o configura las variables
# directamente en Vercel (producción).
#
# IMPORTANTE: NUNCA subas el archivo .env real al repositorio.
# ════════════════════════════════════════════════════════════════════════

# ── Base de Datos Goldneez (SCHEMA AISLADO) ──────────────────────────
# URL de conexión al schema 'goldneez' dentro de la BD de LegacyMark.
# Este schema es INDEPENDIENTE de las tablas principales de LegacyMark.
#
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=goldneez&search_path=goldneez,public
#
# Variable prioritaria para Vercel (usar esta en el panel de Vercel):
GOLDNEEZ_DB_URL="postgresql://legacyuser:YOUR_PASSWORD@YOUR_HOST:5432/legacymark?schema=goldneez&search_path=goldneez,public"

# Variable alternativa local (para desarrollo):
DATABASE_URL="postgresql://legacyuser:YOUR_PASSWORD@YOUR_HOST:5432/legacymark?schema=goldneez&search_path=goldneez,public"

# ── Autenticación ────────────────────────────────────────────────────
# Secreto JWT exclusivo de Goldneez (diferente al de LegacyMark)
JWT_SECRET="goldneez-coffee-exclusive-jwt-secret-CHANGE-IN-PRODUCTION"

# ── Microservicio de Autenticación (opcional) ────────────────────────
# URL del auth-service del monorepo. Si no está disponible, hace fallback
# directo a la base de datos.
AUTH_SERVICE_URL="http://localhost:4001"

# ── WhatsApp / Chat (opcional) ───────────────────────────────────────
# NEXT_PUBLIC_WHATSAPP_NUMBER="573001234567"
# NEXT_PUBLIC_WEB_CHAT_ENDPOINT="https://chat.tudominio.com"
