// ── Draft Versioning & Approval ────────────────────────────────────────────────
model MessageDraft {
  id             String       @id @default(uuid())
  messageId      String?      @map("message_id") // nullable: draft may exist before message is sent
  conversationId String       @map("conversation_id")
  content        String
  version        Int          @default(1)
  status         String       @default("DRAFT") // DRAFT, PENDING_APPROVAL, APPROVED
  createdBy      String       @map("created_by")
  createdAt      DateTime     @default(now()) @map("created_at")
  approvedBy     String?      @map("approved_by")
  approvedAt     DateTime?    @map("approved_at")
  message        Message?     @relation(fields: [messageId], references: [id], onDelete: Cascade)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
  @@map("tbl_message_drafts")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

// ── SLA & Response Time Tracking ───────────────────────────────────────────────
model ConversationSLA {
  id                   String       @id @default(uuid())
  conversationId       String       @unique @map("conversation_id")
  firstResponseMinutes Int          @map("first_response_minutes")
  resolutionMinutes    Int          @map("resolution_minutes")
  status               String       @default("OPEN") // OPEN, MET, BREACHED, PAUSED
  firstResponseAt      DateTime?    @map("first_response_at")
  resolvedAt           DateTime?    @map("resolved_at")
  breachedAt           DateTime?    @map("breached_at")
  warningNotifiedAt    DateTime?    @map("warning_notified_at")
  pausedAt             DateTime?    @map("paused_at")
  pausedMinutes        Int          @default(0) @map("paused_minutes")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  conversation         Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([status])
  @@index([breachedAt])
  @@map("tbl_conversation_slas")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

// ── Audit Logging for Compliance ───────────────────────────────────────────────
model InboxAuditLog {
  id             String        @id @default(uuid())
  conversationId String?       @map("conversation_id")
  companyId      String        @map("company_id")
  userId         String?       @map("user_id")
  action         String // message_sent, status_changed, assigned_to, macro_executed, tag_added, tag_removed
  resourceType   String        @map("resource_type") // conversation, message, macro
  resourceId     String        @map("resource_id")
  oldValue       Json?         @map("old_value")
  newValue       Json?         @map("new_value")
  ipAddress      String?       @map("ip_address")
  userAgent      String?       @map("user_agent")
  metadata       Json?         @default("{}")
  createdAt      DateTime      @default(now()) @map("created_at")
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user           User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([companyId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@map("tbl_inbox_audit_logs")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

// ── Tags History & Audit ──────────────────────────────────────────────────────
model InboxTagAssignment {
  id             String       @id @default(uuid())
