  @@unique([conversationId, tagName, removedAt]) // Allow same tag re-added
  @@index([conversationId])
  @@index([tagName])
  @@index([assignedAt])
  @@map("tbl_inbox_tag_assignments")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

// ── RBAC for Macros ───────────────────────────────────────────────────────────
