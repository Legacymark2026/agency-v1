model AgentSpecialization {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   @default("GENERAL") // SALES, SUPPORT, MARKETING, OPERATIONS, CUSTOM
  icon        String?
  color       String   @default("#0d9488")
  isSystem    Boolean  @default(false) @map("is_system") // System defaults cannot be deleted
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0)
  companyId   String?  @map("company_id") // Null for global/system specializations
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  skills  AgentSkill[]
  presets AgentConfigurationPreset[]
  company Company?                   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([category])
  @@index([isActive])
  @@map("tbl_agent_specializations")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AgentSkill {
  id               String   @id @default(uuid())
  name             String
  description      String?
  category         String   @default("GENERAL") // COMMUNICATION, ANALYSIS, AUTOMATION, NEGOTIATION, etc.
  parameters       Json     @default("{}") // Dynamic parameters for this skill
  isActive         Boolean  @default(true) @map("is_active")
  priority         Int      @default(0) // Order of execution
  specializationId String   @map("specialization_id")
  agentId          String?  @map("agent_id") // Null = available for any agent
  companyId        String   @map("company_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  specialization AgentSpecialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  agent          AIAgent?            @relation(fields: [agentId], references: [id], onDelete: Cascade)
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([specializationId])
  @@index([agentId])
  @@index([companyId])
  @@index([isActive])
  @@map("tbl_agent_skills")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model SkillTemplate {
  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   @default("GENERAL")
  content     Json // Skill configuration content
  parameters  Json     @default("{}") // Default parameters
