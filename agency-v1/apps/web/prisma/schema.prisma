}

model AgentSkillChain {
  id          String   @id @default(cuid())
  companyId   String
  agentId     String
  name        String
  description String?
  tools       Json     @default("[]") // Array of tool identifiers
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  agent   AIAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([companyId])
  @@map("tbl_agent_skill_chains")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

// ══════════════════════════════════════════════════════════════
// AGENT TEAM — PARALLEL WORKFORCE ORCHESTRATION
// ══════════════════════════════════════════════════════════════

model AgentTeam {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  objective   String   @db.Text // What this team is designed to accomplish
  strategy    String   @default("PARALLEL") // PARALLEL | SEQUENTIAL | VOTE
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  members AgentTeamMember[]
  runs    AgentTeamRun[]

  @@index([companyId])
  @@index([isActive])
  @@map("tbl_agent_teams")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AgentTeamMember {
  id       String @id @default(cuid())
  teamId   String
  agentId  String
  role     String @default("WORKER") // ORCHESTRATOR | WORKER | REVIEWER | SYNTHESIZER
  priority Int    @default(0) // Execution order for SEQUENTIAL strategy

  team  AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  agent AIAgent   @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([teamId, agentId])
  @@index([teamId])
  @@map("tbl_agent_team_members")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AgentTeamRun {
  id          String   @id @default(cuid())
  teamId      String
  companyId   String
  trigger     String   @default("MANUAL") // MANUAL | WEBHOOK | SCHEDULE
  input       String   @db.Text
  status      String   @default("PENDING") // PENDING | RUNNING | COMPLETED | FAILED
  outputs     Json     @default("{}") // { agentId: response }
  synthesis   String?  @db.Text // Synthesized final output
  latencyMs   Int?
  tokensTotal Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  team    AgentTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  company Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([companyId])
  @@index([status])
  @@map("tbl_agent_team_runs")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

// ══════════════════════════════════════════════════════════════
// MEDIA ASSET — Almacenamiento de archivos en VPS
// ══════════════════════════════════════════════════════════════

model MediaAsset {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  uploadedById String   @map("uploaded_by_id")
  name         String
  originalName String   @map("original_name")
  url          String   // path relativo: /api/serve/uploads/...
  mimeType     String   @map("mime_type")
  type         String   // 'image' | 'video' | 'document' | 'audio' | 'other'
  sizeBytes    Int      @map("size_bytes")
  duration     Float?   // para videos/audio, en segundos
  width        Int?     // para imágenes/videos
  height       Int?     // para imágenes/videos
  fps          Float?   // para videos
  resolution   String?  // ej. '1920x1080'
  tags         String[] @default([])
  isPublic     Boolean  @default(false) @map("is_public")
  metadata     Json?    @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("MediaUploader", fields: [uploadedById], references: [id])

  @@index([companyId])
  @@index([type])
  @@index([createdAt])
  @@map("tbl_media_assets")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

// ══════════════════════════════════════════════════════════════
// VIDEO RENDER JOB — Trabajos de renderizado en VPS
// ══════════════════════════════════════════════════════════════

model VideoRenderJob {
  id           String    @id @default(uuid())
  companyId    String    @map("company_id")
  projectId    String    @map("project_id")
  status       String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED
  progress     Int       @default(0)         // 0-100
  inputData    Json      @map("input_data")  // { timeline, colorGrades, audioTracks, textOverlays, config }
  outputUrl    String?   @map("output_url")  // URL del video renderizado en VPS
  errorMessage String?   @map("error_message")
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  durationMs   Int?      @map("duration_ms")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  company Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  project VideoEditorProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@map("tbl_video_render_jobs")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}
