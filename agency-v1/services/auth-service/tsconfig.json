{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "lib": ["ES2022"],
    "outDir": "./dist", "rootDir": "./src",
    "strict": true, "noImplicitAny": false,
    "esModuleInterop": true, "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true, "resolveJsonModule": true,
    "declaration": true, "sourceMap": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*", "dist/*"],
      "@config/*": ["src/config/*", "dist/config/*"],
      "@controllers/*": ["src/controllers/*", "dist/controllers/*"],
      "@routes/*": ["src/routes/*", "dist/routes/*"],
      "@models/*": ["src/models/*", "dist/models/*"],
      "@services/*": ["src/services/*", "dist/services/*"],
      "@utilities/*": ["src/utilities/*", "dist/utilities/*"],
      "@types/*": ["src/types/*", "dist/types/*"],
      "@repositories/*": ["src/repositories/*", "dist/repositories/*"],
      "@validators/*": ["src/validators/*", "dist/validators/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
