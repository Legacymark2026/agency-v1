{
  "name": "@agency/grpc",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs'); fs.mkdirSync('dist/proto',{recursive:true}); ['auth.proto','crm.proto'].forEach(f=>fs.copyFileSync('src/proto/'+f,'dist/proto/'+f));\"",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.12.6",
    "@grpc/proto-loader": "^0.7.13"
  },
  "devDependencies": {
    "@types/node": "^20",
    "typescript": "^5"
  }
}
