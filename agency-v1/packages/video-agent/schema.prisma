// Schema para modelos de Video Editor Agent - The Editing Nexus + Asset Scout
// Agregar a tu schema.prisma existente

model VideoProject {
  id              String   @id @default(cuid())
  companyId       String
  name            String
  description     String?
  clips           Json     @default("[]")
  audioUrl        String?
  voiceover       String?
  outputFormat    String   @default("9:16")
  platform        String   @default("reels")
  style           String   @default("cinematic")
  duration        Int      @default(20)
  hookDuration    Int      @default(3)
  status          String   @default("draft")
  
  // Resultados de los agentes
  timeline        Json?
  colorGrade      Json?
  textOverlays    Json     @default("[]")
  manualOverrides Json     @default("[]")
  
  // Metadata avanzada
  metadata        Json?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  versions        EditVersion[]
  externalAssets  ExternalAsset[]
  synthesisAudits SynthesisAudit[]

  @@index([companyId])
  @@index([status])
  @@map("tbl_video_projects")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model EditVersion {
  id          String   @id @default(cuid())
  projectId   String
  version     String   // A, B, C
  name        String
  description String
  timeline    Json
  thumbnail   String?
  status      String   @default("draft")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  project     VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("tbl_edit_versions")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AgentExecution {
  id          String   @id @default(cuid())
  projectId   String
  agentName   String   // logos, croma, phonos, graphos
  status      String   // running, completed, failed
  inputData   Json?
  outputData  Json?
  error       String?
  duration    Int      // ms
  startedAt   DateTime @default(now())
  completedAt DateTime?

  @@index([projectId])
  @@index([agentName])
  @@map("tbl_agent_executions")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model EditorCommand {
  id          String   @id @default(cuid())
  projectId   String
  userId      String?
  rawCommand  String   // Comando original
  parsedCommand Json?  // Comando parseado
  agentName   String
  action      String?
  parameters  Json?
  status      String   // pending, executed, failed
  result      Json?
  error       String?
  createdAt   DateTime @default(now())

  @@index([projectId])
  @@index([agentName])
  @@map("tbl_editor_commands")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AudioConfig {
  id          String   @id @default(cuid())
  projectId   String
  masterLufs  Float    @default(-14)
  layers      Json     // AudioLayer[]
  ducking     Json     // AudioDucking[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([projectId])
  @@map("tbl_audio_configs")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model ExportConfig {
  id          String   @id @default(cuid())
  projectId   String
  format      String   // mp4, mov, webm
  resolution  String   // 1080x1920, 1920x1080, etc.
  codec       String   // h264, h265, vp9
  audioBitrate Int     @default(192)
  frameRate   Int      @default(30)
  status      String   // pending, exporting, completed, failed
  downloadUrl String?
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([projectId])
  @@map("tbl_export_configs")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

// ─────────────────────────────────────────────
// ASSET SCOUT - MODELOS NUEVOS
// ─────────────────────────────────────────────

model ExternalAsset {
  id            String   @id @default(cuid())
  projectId     String
  sourceType    String   // 'ai_generated' | 'stock' | 'uploaded'
  sourceApi     String   // 'midjourney' | 'pexels' | 'elevenlabs' | etc.
  sourceUrl     String?
  localUrl      String?
  thumbnailUrl String?
  prompt        String?
  duration      Float?   // Para videos
  width         Int?
  height        Int?
  status        String   // pending, generating, downloading, ready, applied, failed
  cost          Float?   // Costo en créditos
  metadata      Json?
  
  createdAt     DateTime @default(now())
  appliedAt     DateTime?
  
  project       VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([sourceApi])
  @@map("tbl_external_assets")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model SynthesisAudit {
  id            String   @id @default(cuid())
  projectId     String
  status        String   // pending, in_progress, completed
  
  // Análisis
  scriptLength  Int?
  timelineDuration Float?
  missingDuration Float?
  
  // Huecos detectados
  gaps          Json     // Array de TimelineGap
  
  // Propuestas
  proposals     Json     // Array de AssetProposal
  
  // Resultados
  appliedAssets Json?    // IDs de assets aplicados
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  project       VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("tbl_synthesis_audits")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model ApiKey {
  id          String   @id @default(cuid())
  companyId   String
  provider    String   // 'openai' | 'midjourney' | 'pexels' | 'elevenlabs' | 'suno' | 'adobe_stock'
  apiKey      String   // En producción: encriptado
  isActive    Boolean  @default(true)
  quotaUsed   Int      @default(0)
  quotaLimit  Int      @default(1000)
  lastUsed    DateTime?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([companyId, provider])
  @@index([companyId])
  @@map("tbl_api_keys")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model CreditTransaction {
  id          String   @id @default(cuid())
  companyId   String
  projectId   String?
  action      String   // 'generate_image' | 'search_stock' | 'generate_voice' | etc.
  amount      Int      // Créditos usados
  cost        Float    // Costo real en USD
  provider    String?
  status      String   // pending, completed, refunded
  createdAt   DateTime @default(now())
  
  @@index([companyId])
  @@index([projectId])
  @@map("tbl_credit_transactions")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

