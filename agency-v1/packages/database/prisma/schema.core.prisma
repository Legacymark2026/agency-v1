generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client/core"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Business Core (CRM, Finance, Admin)
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id                        String   @id @default(uuid())
  name                      String
  slug                      String   @unique
  logoUrl                   String?  @map("logo_url")
  industry                  String?
  website                   String?
  subscriptionTier          String   @default("free") @map("subscription_tier")
  subscriptionStatus        String   @default("active") @map("subscription_status")
  onboardingCompleted       Boolean  @default(false) @map("onboarding_completed")
  createdAt                 DateTime @default(now()) @map("created_at")
  stripeCustomerId          String?  @map("stripe_customer_id")
  stripeSubscriptionId      String?  @map("stripe_subscription_id")

  // Core Relations
  teams                     Team[]
  members                   CompanyUser[]
  deals                     Deal[]
  leads                     Lead[]
  invoices                  Invoice[]
  expenses                  Expense[]
  servicePrices             ServicePrice[]
  kanbanProjects            KanbanProject[]

  @@map("companies")
}

model CompanyUser {
  id             String   @id @default(uuid())
  userId         String   @map("user_id") // Soft link to Auth DB
  companyId      String   @map("company_id")
  permissions    Json?    @default("[]")
  invitedBy      String?  @map("invited_by")
  joinedAt       DateTime @default(now()) @map("joined_at")
  teamId         String?  @map("team_id")
  roleName       String   @default("member") @map("role_name")
  
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team           Team?    @relation(fields: [teamId], references: [id])

  @@unique([userId, companyId])
  @@map("company_users")
}

model Team {
  id            String   @id @default(uuid())
  name          String
  description   String?
  companyId     String   @map("company_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  members       CompanyUser[]
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("teams")
}

model Lead {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  email     String?
  phone     String?
  source    String?
  status    String   @default("new")
  assignedToUserId String? @map("assigned_to_user_id") // Soft link
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("leads")
}

model Deal {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  value     Float    @default(0)
  stage     String   @default("lead")
  assignedToUserId String? @map("assigned_to_user_id") // Soft link
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("deals")
}

model Invoice {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  amount    Float
  status    String   @default("pending")
  dueDate   DateTime @map("due_date")
  createdAt DateTime @default(now()) @map("created_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("invoices")
}

model Expense {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  amount    Float
  category  String
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("expenses")
}

model ServicePrice {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  nombre_servicio  String
  categoria        String
  precio_base      Float
  estado           String   @default("activo")
  createdAt        DateTime @default(now()) @map("created_at")
  
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("service_prices")
}

model KanbanProject {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("kanban_projects")
}
