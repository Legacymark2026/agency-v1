generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client/core"
}

datasource db {
  provider = "postgresql"
  url      = env("CORE_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Business Core (CRM, Finance, Admin)
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id                        String   @id @default(uuid())
  name                      String
  slug                      String   @unique
  logoUrl                   String?  @map("logo_url")
  industry                  String?
  website                   String?
  subscriptionTier          String   @default("free") @map("subscription_tier")
  subscriptionStatus        String   @default("active") @map("subscription_status")
  onboardingCompleted       Boolean  @default(false) @map("onboarding_completed")
  createdAt                 DateTime @default(now()) @map("created_at")
  stripeCustomerId          String?  @map("stripe_customer_id")
  stripeSubscriptionId      String?  @map("stripe_subscription_id")

  // Core Relations
  teams                     Team[]
  members                   CompanyUser[]
  deals                     Deal[]
  leads                     Lead[]
  invoices                  Invoice[]
  expenses                  Expense[]
  servicePrices             ServicePrice[]
  kanbanProjects            KanbanProject[]

  @@map("tbl_companies")
}

model CompanyUser {
  id             String   @id @default(uuid())
  userId         String   @map("user_id") // Soft link to Auth DB
  companyId      String   @map("company_id")
  permissions    Json?    @default("[]")
  invitedBy      String?  @map("invited_by")
  joinedAt       DateTime @default(now()) @map("joined_at")
  teamId         String?  @map("team_id")
  roleName       String   @default("member") @map("role_name")
  
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  team           Team?    @relation(fields: [teamId], references: [id])

  @@unique([userId, companyId])
  @@map("tbl_company_users")
}

model Team {
  id            String   @id @default(uuid())
  name          String
  description   String?
  companyId     String   @map("company_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  members       CompanyUser[]
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("tbl_teams")
}

model Lead {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  email     String?
  phone     String?
  source    String?
  status    String   @default("new")
  assignedToUserId String? @map("assigned_to_user_id") // Soft link
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("tbl_leads")
}

model Deal {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  value     Float    @default(0)
  stage     String   @default("lead")
  assignedToUserId String? @map("assigned_to_user_id") // Soft link
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("tbl_deals")
}

model Invoice {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  amount    Float
  status    String   @default("pending")
  dueDate   DateTime @map("due_date")
  createdAt DateTime @default(now()) @map("created_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("tbl_invoices")
}

model Expense {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  amount    Float
  category  String
  date      DateTime
  createdAt DateTime @default(now()) @map("created_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("tbl_expenses")
}

model ServicePrice {
  id               String   @id @default(uuid())
  companyId        String   @map("company_id")
  nombre_servicio  String
  categoria        String
  precio_base      Float
  estado           String   @default("activo")
  createdAt        DateTime @default(now()) @map("created_at")
  
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("tbl_service_prices")
}

model KanbanProject {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  status    String   @default("active")
  createdAt DateTime @default(now()) @map("created_at")

  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("tbl_kanban_projects")
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PlanType {
  FIXED
  PERCENTAGE
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model AffiliateProfile {
  id              String          @id @default(uuid())
  userId          String          @unique @map("user_id") // Soft link a Auth DB (User)
  code            String          @unique @map("code") // ej: "JUAN10"
  status          AffiliateStatus @default(ACTIVE) @map("status")
  commissionPlanId String         @map("commission_plan_id")
  
  commissionPlan  CommissionPlan  @relation(fields: [commissionPlanId], references: [id])
  clicks          Click[]
  referrals       Referral[]

  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  schemaVersion   Int             @default(0) @map("col_schema_version")
  deletedAt       DateTime?       @map("col_deleted_at")

  @@index([code])
  @@map("tbl_affiliate_profiles")
}

model CommissionPlan {
  id                String             @id @default(uuid())
  name              String             @map("name")
  type              PlanType           @map("type")
  value             Decimal            @db.Decimal(10, 2) @map("value")
  cookieLifetimeInt Int                @default(30) @map("cookie_lifetime_int") // en días
  profiles          AffiliateProfile[]

  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  schemaVersion     Int                @default(0) @map("col_schema_version")
  deletedAt         DateTime?          @map("col_deleted_at")

  @@map("tbl_commission_plans")
}

model Click {
  id            String           @id @default(uuid())
  affiliateCode String           @map("affiliate_code")
  ip            String           @map("ip")
  userAgent     String           @map("user_agent")
  referer       String?          @map("referer")
  
  affiliate     AffiliateProfile @relation(fields: [affiliateCode], references: [code])

  createdAt     DateTime         @default(now()) @map("created_at")
  schemaVersion Int              @default(0) @map("col_schema_version")
  deletedAt     DateTime?        @map("col_deleted_at")

  @@index([affiliateCode])
  @@index([ip, affiliateCode])
  @@map("tbl_affiliate_clicks")
}

model Referral {
  id              String           @id @default(uuid())
  affiliateId     String           @map("affiliate_id")
  referredUserId  String           @unique @map("referred_user_id") // Comprador
  orderId         String           @unique @map("order_id") // Idempotencia de orden
  orderAmount     Decimal          @db.Decimal(10, 2) @map("order_amount")
  commissionAmount Decimal         @db.Decimal(10, 2) @map("commission_amount")
  status          PayoutStatus     @default(PENDING) @map("status")
  payoutId        String?          @map("payout_id")

  affiliate       AffiliateProfile @relation(fields: [affiliateId], references: [id])
  payout          Payout?          @relation(fields: [payoutId], references: [id])

  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  schemaVersion   Int              @default(0) @map("col_schema_version")
  deletedAt       DateTime?        @map("col_deleted_at")

  @@index([affiliateId])
  @@index([orderId])
  @@map("tbl_affiliate_referrals")
}

model Payout {
  id          String     @id @default(uuid())
  affiliateId String     @map("affiliate_id")
  amount      Decimal    @db.Decimal(10, 2) @map("amount")
  status      String     @default("PROCESSING") // PAID, FAILED, PROCESSING
  paidAt      DateTime?  @map("paid_at")
  referrals   Referral[]

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  schemaVersion Int      @default(0) @map("col_schema_version")
  deletedAt   DateTime?  @map("col_deleted_at")

  @@index([affiliateId])
  @@map("tbl_affiliate_payouts")
}

