generator client {
  provider = "prisma-client-js"
  col_output = "../node_modules/@prisma/client/auth"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("AUTH_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth & Identity Management (IAM)
// ─────────────────────────────────────────────────────────────────────────────

model tbl_user {
  id              String               @id @default(uuid())
  name            String?
  col_email String?              @unique
  col_email_verified DateTime?            @map("email_verified")
  image           String?
  col_password_hash String?              @map("password_hash")
  col_first_name String?              @map("first_name")
  col_last_name String?              @map("last_name")
  phone           String?
  col_role String               @default("guest")
  col_mfa_enabled Boolean              @default(false) @map("mfa_enabled")
  col_mfa_secret String?              @map("mfa_secret")
  col_created_at DateTime             @default(now()) @map("created_at")
  col_updated_at DateTime             @updatedAt @map("updated_at")
  col_deactivated_at DateTime?            @map("deactivated_at")
  col_admin_notes String?              @map("admin_notes")
  col_backup_codes Json?                @map("backup_codes")
  col_custom_tag String?              @map("custom_tag")
  col_job_title String?              @map("job_title")
  col_global_role String               @default("client_user") @map("global_role")

  // Auth local relations
  accounts            Account[]
  sessions            Session[]
  profile             UserProfile?
  resourcePermissions ResourcePermission[]
  apiKeys             ApiKey[]

  @@index([role])
  @@index([email])
  @@index([globalRole])
  @@map("tbl_tbl_tbl_tbl_tbl_tbl_tbl_tbl_tbl_tbl_tbl_tbl_users")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_user_profile {
  col_schema_version Int @default(1) @map("col_schema_version")
  id               String  @id @default(uuid())
  col_user_id String  @unique @map("user_id")
  col_job_title String? @map("job_title")
  department       String?
  bio              String?
  col_social_links Json?   @default("{}") @map("social_links")
  col_preferences Json?   @default("{\"theme\": \"system\", \"notifications\": {\"email\": true}}")
  col_metadata Json?   @default("{}")
  col_google_analytics Json?   @map("google_analytics_config")
  col_facebook_pixel Json?   @map("facebook_pixel_config")
  col_google_tag_manager Json?   @map("google_tag_manager_config")
  col_hotjar Json?   @map("hotjar_config")
  col_user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tbl_user_profiles")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_account {
  id                String  @id @default(uuid())
  col_user_id String  @map("user_id")
  type              String
  provider String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  col_user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("tbl_accounts")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_session {
  id           String   @id @default(uuid())
  col_session_token String   @unique @map("session_token")
  col_user_id String   @map("user_id")
  expires DateTime
  ipAddress    String?  @map("ip_address")
  col_user_agent String?  @map("user_agent")
  col_user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tbl_sessions")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_verification_token {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("tbl_verification_tokens")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_password_reset_token {
  id        String   @id @default(cuid())
  email String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  col_created_at DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([token])
  @@map("tbl_password_reset_tokens")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

// ─────────────────────────────────────────────────────────────────────────────
// Role-Based Access Control (RBAC)
// ─────────────────────────────────────────────────────────────────────────────

model tbl_role_config {
  id            String   @id @default(uuid())
  col_role_name String   @unique @map("role_name")
  col_allowed_routes Json     @default("[]") @map("allowed_routes")
  description   String?
  col_is_active Boolean  @default(true) @map("is_active")
  col_created_at DateTime @default(now()) @map("created_at")
  col_updated_at DateTime @updatedAt @map("updated_at")

  @@index([roleName])
  @@map("tbl_role_configs")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_role {
  id          String           @id @default(uuid())
  col_company_id String           @map("company_id") // Soft link to Core DB
  name        String
  description String?
  col_is_default Boolean          @default(false) @map("is_default")
  col_is_active Boolean          @default(true) @map("is_active")
  col_priority Int              @default(0)
  col_created_at DateTime         @default(now()) @map("created_at")
  col_updated_at DateTime         @updatedAt @map("updated_at")
  permissions RolePermission[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("tbl_roles")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_permission {
  id              String           @id @default(uuid())
  col_name String           @unique
  module          String
  description     String?
  col_is_active Boolean          @default(true) @map("is_active")
  col_created_at DateTime         @default(now()) @map("created_at")
  col_updated_at DateTime         @updatedAt @map("updated_at")
  rolePermissions RolePermission[]

  @@index([module])
  @@map("tbl_permissions")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_role_permission {
  id           String     @id @default(uuid())
  col_role_id String     @map("role_id")
  col_permission_id String     @map("permission_id")
  col_created_at DateTime   @default(now()) @map("created_at")
  col_permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  col_role Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("tbl_role_permissions")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_resource_permission {
  id           String   @id @default(uuid())
  col_user_id String   @map("user_id")
  col_company_id String   @map("company_id") // Soft link
  resourceType String
  resourceId   String   @map("resource_id") // Soft link
  permission String
  access       Boolean  @default(true)
  col_created_at DateTime @default(now()) @map("created_at")
  col_updated_at DateTime @updatedAt @map("updated_at")
  col_user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, resourceType, resourceId, permission])
  @@index([userId, companyId])
  @@index([resourceType, resourceId])
  @@map("tbl_resource_permissions")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_api_key {
  id         String    @id @default(uuid())
  name String
  keyHash    String    @unique @map("key_hash")
  col_user_id String?   @map("user_id")
  col_company_id String?   @map("company_id") // Soft col_link isActive   Boolean   @default(true) @map("is_active")
  col_created_at DateTime  @default(now()) @map("created_at")
  col_created_by String?   @map("created_by")
  col_expires_at DateTime? @map("expires_at")
  col_last_used_at DateTime? @map("last_used_at")
  col_prefix String?   @map("prefix")
  col_scopes String[]  @default([])
  col_user User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("tbl_api_keys")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_auth_refresh_token {
  id            String   @id @default(uuid()) @map("col_id")
  col_user_id String   @map("col_user_id")
  col_refresh_token String   @unique @map("col_refresh_token")
  col_created_at DateTime @default(now()) @map("col_created_at")
  col_expires_at DateTime? @map("col_expires_at")
  @@map("tbl_auth_refresh_tokens")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}
