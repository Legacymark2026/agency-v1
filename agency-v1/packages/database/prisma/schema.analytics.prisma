generator client {
  provider = "prisma-client-js"
  col_output = "../node_modules/@prisma/client/analytics"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("ANALYTICS_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Analytics & Audit Logs (High Write Volume)
// ─────────────────────────────────────────────────────────────────────────────

model tbl_user_activity_log {
  id        String   @id @default(uuid())
  col_user_id String?  @map("user_id") // Soft link
  action    String
  details   Json?
  col_ip_address String?  @map("ip_address")
  col_user_agent String?  @map("user_agent")
  col_created_at DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([createdAt])
  @@map("tbl_tbl_tbl_tbl_tbl_tbl_user_activity_logs")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_project_view {
  id        String   @id @default(uuid())
  col_project_id String   @map("project_id") // Soft col_link ipHash    String   @map("ip_hash")
  col_user_agent String?  @map("user_agent")
  referer   String?
  col_created_at DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([createdAt])
  @@map("tbl_project_views")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_post_view {
  id        String   @id @default(uuid())
  col_post_id String   @map("post_id") // Soft col_link ipHash    String   @map("ip_hash")
  col_user_agent String?  @map("user_agent")
  referer   String?
  col_created_at DateTime @default(now()) @map("created_at")

  @@index([postId])
  @@index([createdAt])
  @@map("tbl_post_views")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_usage_log {
  id        String   @id @default(uuid())
  col_company_id String   @map("company_id") // Soft link
  feature String
  metric    Int      @default(1)
  col_created_at DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([createdAt])
  @@map("tbl_usage_logs")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_integration_log {
  id            String   @id @default(uuid())
  col_integration_id String   @map("integration_id") // Soft link
  status        String
  payload       Json?
  col_error_message String?  @map("error_message")
  col_created_at DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@index([status])
  @@map("tbl_integration_logs")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_notification_delivery_log {
  id             String   @id @default(uuid())
  col_notification_id String   @map("notification_id")
  col_user_id String   @map("user_id") // Soft link
  channel        String
  status String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@map("tbl_notification_delivery_logs")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}
