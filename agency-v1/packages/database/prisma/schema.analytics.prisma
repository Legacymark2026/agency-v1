generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client/analytics"
}

datasource db {
  provider = "postgresql"
  url      = env("ANALYTICS_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Analytics & Audit Logs (High Write Volume)
// ─────────────────────────────────────────────────────────────────────────────

model UserActivityLog {
  id        String   @default(uuid()) @db.VarChar(36)
  userId    String?  @map("user_id") @db.VarChar(36) // Soft link
  action    String   @db.VarChar(255)
  details   Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("tbl_user_activity_logs")
}

model ProjectView {
  id        String   @id @default(uuid())
  projectId String   @map("project_id") // Soft link
  ipHash    String   @map("ip_hash")
  userAgent String?  @map("user_agent")
  referer   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([createdAt])
  @@map("tbl_project_views")
}

model PostView {
  id        String   @id @default(uuid())
  postId    String   @map("post_id") // Soft link
  ipHash    String   @map("ip_hash")
  userAgent String?  @map("user_agent")
  referer   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([postId])
  @@index([createdAt])
  @@map("tbl_post_views")
}

model UsageLog {
  id        String   @default(uuid()) @db.VarChar(36)
  companyId String   @map("company_id") @db.VarChar(36) // Soft link
  feature   String   @db.VarChar(255)
  metric    Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([id, createdAt])
  @@index([companyId])
  @@index([createdAt])
  @@map("tbl_usage_logs")
}

model IntegrationLog {
  id            String   @id @default(uuid())
  integrationId String   @map("integration_id") // Soft link
  status        String
  payload       Json?
  errorMessage  String?  @map("error_message")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([integrationId])
  @@index([status])
  @@map("tbl_integration_logs")
}

model NotificationDeliveryLog {
  id             String   @id @default(uuid())
  notificationId String   @map("notification_id")
  userId         String   @map("user_id") // Soft link
  channel        String
  status         String
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@index([status])
  @@map("tbl_notification_delivery_logs")
}
