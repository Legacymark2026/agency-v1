model VideoEditorProject {

  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  name         String
  config       Json // ProjectConfig
  clips        Json // Clip[]
  audioTracks  Json // AudioTrack[]
  textOverlays Json // TextOverlay[]
  colorGrades  Json // ColorGrade[]
  speedRamps   Json // SpeedRamp[]
  soundLayers  Json // SoundLayer[]
  timeline     Json? // Timeline
  qualityCheck Json? // { passed, issues }
  activeSessionId String? @unique @map("active_session_id")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  performanceLogs VideoPerformanceLog[]
  renderJobs      VideoRenderJob[]
  aiSessions      VideoAISession[]      @relation("ProjectSessions")
  activeSession   VideoAISession?       @relation("ActiveSession", fields: [activeSessionId], references: [id], onDelete: SetNull)
  brandStyle      BrandStyle?           @relation(fields: [brandStyleId], references: [id], onDelete: SetNull)
  brandStyleId    String?               @map("brand_style_id")
  versions        VersionSnapshot[]
  comments        VideoComment[]
  exportJobs      ExportJob[]

  @@index([companyId])
  @@map("tbl_video_editor_projects")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model VideoAISession {

  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  projectId   String   @map("project_id")
  status      String   @default("ACTIVE")  // ACTIVE | COMPLETED | ABANDONED
  prompt      String?  @map("initial_prompt") @db.Text  // "Edita esto estilo TikTok..."
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  project        VideoEditorProject  @relation("ProjectSessions", fields: [projectId], references: [id], onDelete: Cascade)
  activeProject  VideoEditorProject? @relation("ActiveSession")
  messages       VideoAIMessage[]
  historyLogs    VideoEditHistory[]
  editProposals  EditProposal[]
  editConflicts  EditConflict[]

  @@index([companyId])
  @@index([projectId])
  @@index([status])
  @@map("tbl_video_ai_sessions")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model VideoAIMessage {

  id          String    @id @default(uuid())
  sessionId   String    @map("session_id")
  role        String    // "user" | "assistant" | "system" | "tool"
  content     String    @db.Text
  toolCalls   Json?     @map("tool_calls")   // [{name: "cut_track", args: {...}}]
  toolResults Json?     @map("tool_results")
  createdAt   DateTime  @default(now()) @map("created_at")

  session     VideoAISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([role])
  @@map("tbl_video_ai_messages")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model VideoEditHistory {

  id          String    @id @default(uuid())
  sessionId   String    @map("session_id")
  action      String    // "cut" | "insert_text" | "color_grade" | "speed_ramp" | "smart_crop" | "inject_broll"
  author      String    @default("human") @map("edit_author")  // "ai" | "human" | "merged"
  confidence  Float     @default(1.0) @map("edit_confidence")
  description String    @db.Text
  beforeState Json      @map("before_state")
  afterState  Json      @map("after_state")
  undone      Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")

  session     VideoAISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([action])
  @@index([undone])
  @@index([author])
  @@map("tbl_video_edit_history")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model EditProposal {

  id          String    @id @default(uuid())
  sessionId   String    @map("session_id")
  projectId   String    @map("project_id")
  type        String    @map("proposal_type")  // "cut" | "color" | "text" | "audio" | "transition" | "broll" | "crop"
  title       String
  description String    @db.Text
  confidence  Float     @map("proposal_confidence")  // 0.0 - 1.0
  status      String    @default("pending")  // "pending" | "approved" | "rejected" | "applied"
  beforeState Json      @map("before_state")
  afterState  Json      @map("after_state")
  metadata    Json?     // {reason, impact, alternatives}
  createdAt   DateTime  @default(now()) @map("created_at")
  respondedAt DateTime? @map("responded_at")

  session     VideoAISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([projectId])
  @@index([status])
  @@index([confidence])
  @@map("tbl_edit_proposals")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model EditConflict {

  id          String    @id @default(uuid())
  sessionId   String    @map("session_id")
  projectId   String    @map("project_id")
  elementId   String    @map("element_id")
  elementType String    @map("element_type")  // "clip" | "text" | "audio" | "color"
  aiEdit      Json      @map("ai_edit")
  humanEdit   Json      @map("human_edit")
  resolved    Boolean   @default(false)
  resolution  String?   @map("conflict_resolution")  // "ai" | "human" | "merged" | "discarded"
  resolutionNote String? @map("resolution_note") @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  resolvedAt  DateTime? @map("resolved_at")

  session     VideoAISession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([projectId])
  @@index([resolved])
  @@map("tbl_edit_conflicts")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

