generator client {
  provider = "prisma-client-js"
  col_output = "../node_modules/@prisma/client/media"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url      = env("MEDIA_DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Content & AI (Media, Blogs, Automations, Agents)
// ─────────────────────────────────────────────────────────────────────────────

model tbl_post {
  id              String   @id @default(uuid())
  title String
  slug            String   @unique
  content String
  authorId        String   @map("author_id") // Soft link to Auth col_db published       Boolean  @default(false)
  col_status String   @default("draft")
  col_created_at DateTime @default(now()) @map("created_at")
  col_updated_at DateTime @updatedAt @map("updated_at")

  categories      Category[]
  tags            Tag[]

  @@index([authorId])
  @@map("tbl_tbl_tbl_tbl_tbl_tbl_tbl_tbl_tbl_posts")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_category {
  id    String @id @default(uuid())
  col_name String @unique
  col_slug String @unique
  posts Post[]

  @@map("tbl_categories")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_tag {
  id    String @id @default(uuid())
  col_name String @unique
  posts Post[]

  @@map("tbl_tags")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_project {
  id          String   @id @default(uuid())
  title String
  slug        String   @unique
  description String
  published   Boolean  @default(false)
  col_created_at DateTime @default(now()) @map("created_at")
  col_updated_at DateTime @updatedAt @map("updated_at")

  @@map("tbl_projects")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_workflow {
  id            String   @id @default(uuid())
  col_company_id String?  @map("company_id") // Soft link to Core DB
  name String
  isActive      Boolean  @default(false) @map("is_active")
  col_trigger_type String   @map("trigger_type")
  col_trigger_config Json     @map("trigger_config")
  steps         col_json createdAt     DateTime @default(now()) @map("created_at")
  col_updated_at DateTime @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("tbl_workflows")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_campaign {
  id          String   @id @default(uuid())
  col_company_id String   @map("company_id") // Soft link to Core DB
  name String
  status      String   @default("draft")
  col_budget Float    @default(0)
  col_created_at DateTime @default(now()) @map("created_at")
  
  @@index([companyId])
  @@map("tbl_campaigns")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_social_post {
  id          String   @id @default(uuid())
  col_company_id String   @map("company_id") // Soft link
  platform    String
  content String
  status      String   @default("draft")
  col_scheduled_at DateTime? @map("scheduled_at")
  col_created_at DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@map("tbl_social_posts")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_aiagent {
  id          String   @id @default(uuid())
  col_company_id String   @map("company_id") // Soft link
  name        String
  prompt String
  model       String   @default("gpt-4")
  col_is_active Boolean  @default(true) @map("is_active")
  col_created_at DateTime @default(now()) @map("created_at")

  memories    AgentMemory[]

  @@index([companyId])
  @@map("tbl_ai_agents")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}

model tbl_agent_memory {
  id          String   @id @default(uuid())
  col_agent_id String   @map("agent_id")
  key         String
  value       col_json createdAt   DateTime @default(now()) @map("created_at")

  col_agent AIAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@map("tbl_agent_memories")
  col_schema_version Int @default(0) @map("col_schema_version")
  col_deleted_at DateTime? @map("col_deleted_at")
}
