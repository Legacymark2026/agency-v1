generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/@prisma/client/media"
}

datasource db {
  provider = "postgresql"
  url      = env("MEDIA_DATABASE_URL")
}

enum AffiliateStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum PlanType {
  FIXED
  PERCENTAGE
}

enum PayoutStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Post {

  id              String      @id @default(uuid())
  title           String
  slug            String      @unique
  excerpt         String?
  content         String
  coverImage      String?     @map("cover_image")
  imageAlt        String?     @map("image_alt")
  published       Boolean     @default(false)
  metaTitle       String?     @map("meta_title")
  metaDescription String?     @map("meta_description")
  canonicalUrl    String?     @map("canonical_url")
  focusKeyword    String?     @map("focus_keyword")
  status          String      @default("draft")
  scheduledDate   DateTime?   @map("scheduled_date")
  authorId        String      @map("author_id")
  seriesId        String?     @map("series_id")
  seriesOrder     Int?        @map("series_order")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  categories      Category[]
  tags            Tag[]
  comments        Comment[]
  likes           PostLike[]
  series          PostSeries? @relation(fields: [seriesId], references: [id])
  faqs            Json?       @default("[]")

  @@index([authorId])
  @@index([seriesId])
  @@map("tbl_posts")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model Project {

  id                  String                @id @default(uuid())
  title               String
  slug                String                @unique
  description         String
  content             String?
  client              String?
  coverImage          String?               @map("cover_image")
  imageAlt            String?               @map("image_alt")
  gallery             Json?                 @default("[]")
  published           Boolean               @default(false)
  metaTitle           String?               @map("meta_title")
  metaDescription     String?               @map("meta_description")
  focusKeyword        String?               @map("focus_keyword")
  status              String                @default("draft")
  scheduledDate       DateTime?             @map("scheduled_date")
  featured            Boolean               @default(false)
  displayOrder        Int                   @default(0) @map("display_order")
  startDate           DateTime?             @map("start_date")
  endDate             DateTime?             @map("end_date")
  testimonial         String?
  results             Json?                 @default("[]")
  projectUrl          String?               @map("project_url")
  categoryId          String?               @map("category_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  clientLogo          String?               @map("client_logo")
  pdfUrl              String?               @map("pdf_url")
  private             Boolean               @default(false)
  seoScore            Int                   @default(0)
  team                Json?                 @default("[]")
  techStack           Json?                 @default("[]")
  videoUrl            String?               @map("video_url")
  category            ProjectCategory?      @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([status])
  @@index([featured])
  @@map("tbl_projects")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model ProjectCategory {

  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  color       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  projects    Project[]

  @@map("tbl_project_categories")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model ProjectTag {

  id                  String                @id @default(uuid())
  name                String                @unique

  @@map("tbl_project_tags")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model Tag {

  id    String @id @default(uuid())
  name  String @unique
  posts Post[]

  @@map("tbl_tags")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model Category {

  id    String @id @default(uuid())
  name  String @unique
  slug  String @unique
  posts Post[]

  @@map("tbl_categories")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model Workflow {

  id            String              @id @default(uuid())
  name          String
  description   String?
  isActive      Boolean             @default(false) @map("is_active")
  triggerType   String              @map("trigger_type")
  triggerConfig Json                @map("trigger_config")
  steps         Json
  versions      Json?               @default("[]")
  isTemplate    Boolean             @default(false) @map("is_template")
  category      String?             @map("category")
  companyId     String?             @map("company_id")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([companyId])
  @@map("tbl_workflows")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model PostLike {

  id        String   @id @default(uuid())
  postId    String   @map("post_id")
  sessionId String   @map("session_id")
  createdAt DateTime @default(now()) @map("created_at")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, sessionId])
  @@index([postId])
  @@map("tbl_post_likes")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model Comment {

  id          String        @id @default(uuid())
  content     String
  authorName  String        @map("author_name")
  authorEmail String        @map("author_email")
  authorUrl   String?       @map("author_url")
  postId      String        @map("post_id")
  parentId    String?       @map("parent_id")
  approved    Boolean       @default(false)
  flagged     Boolean       @default(false)
  ipHash      String?       @map("ip_hash")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  deleted     Boolean       @default(false) @map("deleted")
  likeCount   Int           @default(0) @map("like_count")
  likes       CommentLike[]
  parent      Comment?      @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies     Comment[]     @relation("CommentReplies")
  post        Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([parentId])
  @@index([approved])
  @@index([deleted])
  @@map("tbl_comments")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model CommentLike {

  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  ipHash    String   @map("ip_hash")
  createdAt DateTime @default(now()) @map("created_at")
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([commentId, ipHash])
  @@index([commentId])
  @@map("tbl_comment_likes")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model NewsletterSubscription {

  id             String    @id @default(uuid())
  email          String    @unique
  name           String?
  source         String    @default("blog")
  confirmed      Boolean   @default(false)
  confirmToken   String?   @map("confirm_token")
  frequency      String    @default("weekly")
  interests      Json?     @default("[]")
  unsubscribed   Boolean   @default(false)
  unsubscribedAt DateTime? @map("unsubscribed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([confirmed])
  @@index([unsubscribed])
  @@map("tbl_newsletter_subscriptions")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model PostSeries {

  id          String   @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  coverImage  String?  @map("cover_image")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  posts       Post[]

  @@map("tbl_post_series")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model ReadingListItem {

  id       String   @id @default(uuid())
  userId   String   @map("user_id")
  postSlug String   @map("post_slug")
  addedAt  DateTime @default(now()) @map("added_at")

  @@unique([userId, postSlug])
  @@index([userId])
  @@map("tbl_reading_list_items")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model Campaign {

  id              String           @id @default(uuid())
  name            String
  code            String           @unique
  platform        String
  status          String           @default("ACTIVE")
  budget          Float?
  startDate       DateTime?        @map("start_date")
  endDate         DateTime?        @map("end_date")
  description     String?
  impressions     Int              @default(0)
  clicks          Int              @default(0)
  conversions     Int              @default(0)
  spend           Float            @default(0)
  companyId       String           @map("company_id")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  approvalStatus  String           @default("DRAFT") @map("approval_status")
  approvedById    String?          @map("approved_by_id")
  launchStatus    String           @default("PENDING") @map("launch_status")
  launchedAt      DateTime?        @map("launched_at")
  parameters      Json?
  trackingConfig  Json?            @map("tracking_config")
  targeting       Json?            // Structured targeting: age, gender, locations, interests, lookalike, remarketing
  creative        Json?            // Headlines, descriptions, primaryTexts, CTA, assetUrls, adGroups
  dayParting      Json?            @map("day_parting") // Weekly schedule grid
  brandManual     Json?            @map("brand_manual") // Brand identity and guidelines
  abTestConfig    Json?            @map("ab_test_config") // A/B test variants config
  utmConfig       Json?            @map("utm_config") // UTM source/medium/campaign/content
  platformConfigs Json?            @map("platform_configs") // Per-platform advanced settings (keywords, pixel, etc)
  budgetType      String?          @default("DAILY") @map("budget_type") // DAILY or LIFETIME
  bidStrategy     String?          @map("bid_strategy") // LOWEST_COST, COST_CAP, etc
  bidAmount       Float?           @map("bid_amount")
  pacing          String?          @default("STANDARD") // STANDARD or ACCELERATED
  currency        String?          @default("USD")
  objective       String?          // LEAD_GENERATION, CONVERSIONS, etc

  @@index([companyId])
  @@index([code])
  @@index([status])
  @@map("tbl_campaigns")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model Expert {

  id          String   @id @default(uuid())
  name        String
  role        String
  bio         String?
  imageUrl    String?  @map("image_url")
  socialLinks Json?    @default("{}") @map("social_links")
  order       Int      @default(0)
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  badgeId     String?  @map("badge_id")
  iconName    String?  @map("icon_name")
  skills      String[] @default([])

  @@index([order])
  @@index([isVisible])
  @@map("tbl_experts")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model Experiment {

  id          String    @id @default(uuid())
  name        String
  description String?
  status      String    @default("DRAFT")
  type        String    @default("AB_TEST")
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  variants    Json
  metrics     Json
  results     Json?
  winnerId    String?   @map("winner_id")
  companyId   String    @map("company_id")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@map("tbl_experiments")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model Annotation {

  id        String   @id @default(uuid())
  date      DateTime
  content   String
  category  String
  authorId  String?  @map("author_id")
  companyId String   @map("company_id")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([companyId])
  @@index([date])
  @@map("tbl_annotations")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model SocialPost {

  id             String              @id @default(uuid())
  content        String
  mediaUrls      Json?               @default("[]")
  platforms      Json                @default("[]")
  status         String              @default("DRAFT")
  scheduledAt    DateTime?           @map("scheduled_at")
  publishedAt    DateTime?           @map("published_at")
  authorId       String              @map("author_id")
  campaignId     String?             @map("campaign_id")
  companyId      String              @map("company_id")
  approvalStatus String              @default("PENDING") @map("approval_status")
  approvedById   String?             @map("approved_by_id")
  internalNotes  String?             @map("internal_notes")
  isEvergreen    Boolean             @default(false) @map("is_evergreen")
  timezone       String?
  targetUrl      String?             @map("target_url")
  tiktokAudioId  String?             @map("tiktok_audio_id")
  firstComment   String?             @map("first_comment")
  utmCampaign    String?             @map("utm_campaign")
  utmSource      String?             @map("utm_source")
  utmMedium      String?             @map("utm_medium")
  metrics        Json?
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@index([companyId])
  @@index([status])
  @@index([approvalStatus])
  @@map("tbl_social_posts")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AgentConversation {

  id              String         @id @default(uuid())
  title           String         @default("Nueva conversación")
  userId          String?        @map("user_id")
  companyId       String         @map("company_id")
  agentId         String?        @map("agent_id")
  contactId       String?        @map("contact_id")
  status          String         @default("ACTIVE")
  suspendedUntil  DateTime?      @map("suspended_until")
  suspendedReason String?        @map("suspended_reason")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  agent           AIAgent?       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages        AgentMessage[]

  @@index([userId])
  @@index([companyId])
  @@index([agentId, status])
  @@map("tbl_agent_conversations")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AgentMessage {

  id              String            @id @default(uuid())
  conversationId  String            @map("conversation_id")
  role            String
  content         String
  rawContent      String?           @map("raw_content")
  sentimentScore  Float?            @map("sentiment_score")
  isHumanOverride Boolean           @default(false) @map("is_human_override")
  tokensUsed      Int?              @map("tokens_used")
  latencyMs       Int?              @map("latency_ms")
  createdAt       DateTime          @default(now()) @map("created_at")
  conversation    AgentConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@map("tbl_agent_messages")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AgentConfig {

  id                 String   @id @default(uuid())
  companyId          String   @unique @map("company_id")
  isActive           Boolean  @default(true) @map("is_active")
  systemPrompt       String?  @map("system_prompt")
  llmModel           String   @default("gemini-2.0-flash-lite") @map("llm_model")
  temperature        Float    @default(0.7)
  maxTokens          Int      @default(1024) @map("max_tokens")
  adminWhatsappPhone String?  @map("admin_whatsapp_phone")
  monthlySalesTarget Float?   @map("monthly_sales_target")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("tbl_agent_configs")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AIAgent {

  id                        String              @id @default(uuid())
  companyId                 String              @map("company_id")
  name                      String
  description               String?
  agentType                 String              @default("CUSTOM") @map("agent_type")
  isActive                  Boolean             @default(true) @map("is_active")
  isInboxAgent              Boolean             @default(false) @map("is_inbox_agent")
  systemPrompt              String              @map("system_prompt")
  llmModel                  String              @default("gemini-2.0-flash") @map("llm_model")
  temperature               Float               @default(0.4)
  maxTokens                 Int                 @default(400) @map("max_tokens")
  enabledTools              Json                @default("[]") @map("enabled_tools")
  strictRagMode             Boolean             @default(false) @map("strict_rag_mode")
  humanTransferWebhook      String?             @map("human_transfer_webhook")
  suspensionDurationMinutes Int                 @default(30) @map("suspension_duration_minutes")
  priorityAlpha             Boolean             @default(true) @map("priority_alpha")
  frustrationThreshold      Float               @default(0.8) @map("frustration_threshold")
  enforceTempClamp          Boolean             @default(false) @map("enforce_temp_clamp")
  enforceTokenLimit         Boolean             @default(true) @map("enforce_token_limit")
  simulateLatency           Boolean             @default(true) @map("simulate_latency")
  filterRoboticLists        Boolean             @default(true) @map("filter_robotic_lists")
  learningMode              String              @default("MANUAL") @map("learning_mode")
  voiceId                   String?             @map("voice_id")
  stability                 Float               @default(0.5)
  similarityBoost           Float               @default(0.75) @map("similarity_boost")
  accentRegion              String?             @map("accent_region")
  gender                    String?
  createdAt                 DateTime            @default(now()) @map("created_at")
  updatedAt                 DateTime            @updatedAt @map("updated_at")
  conversations             AgentConversation[]
  agentSkills               AgentSkill[]
  skillChains               AgentSkillChain[]
  agentMemories             AgentMemory[]
  agentTeamMembers          AgentTeamMember[]

  @@index([companyId])
  @@index([isActive])
  @@index([companyId, isActive])
  @@map("tbl_ai_agents")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AgentSpecialization {

  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   @default("GENERAL") // SALES, SUPPORT, MARKETING, OPERATIONS, CUSTOM
  icon        String?
  color       String   @default("#0d9488")
  isSystem    Boolean  @default(false) @map("is_system") // System defaults cannot be deleted
  isActive    Boolean  @default(true) @map("is_active")
  order       Int      @default(0)
  companyId   String?  @map("company_id") // Null for global/system specializations
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  skills  AgentSkill[]
  presets AgentConfigurationPreset[]

  @@index([companyId])
  @@index([category])
  @@index([isActive])
  @@map("tbl_agent_specializations")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AgentSkill {

  id               String   @id @default(uuid())
  name             String
  description      String?
  category         String   @default("GENERAL") // COMMUNICATION, ANALYSIS, AUTOMATION, NEGOTIATION, etc.
  parameters       Json     @default("{}") // Dynamic parameters for this skill
  isActive         Boolean  @default(true) @map("is_active")
  priority         Int      @default(0) // Order of execution
  specializationId String   @map("specialization_id")
  agentId          String?  @map("agent_id") // Null = available for any agent
  companyId        String   @map("company_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  specialization AgentSpecialization @relation(fields: [specializationId], references: [id], onDelete: Cascade)
  agent          AIAgent?            @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([specializationId])
  @@index([agentId])
  @@index([companyId])
  @@index([isActive])
  @@map("tbl_agent_skills")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model SkillTemplate {

  id          String   @id @default(uuid())
  name        String
  description String?
  category    String   @default("GENERAL")
  content     Json // Skill configuration content
  parameters  Json     @default("{}") // Default parameters
  isGlobal    Boolean  @default(false) @map("is_global") // Available to all companies
  isPremium   Boolean  @default(false) @map("is_premium") // Requires specific subscription
  tags        String[] @default([])
  downloads   Int      @default(0) @map("downloads")
  companyId   String?  @map("company_id") // Creator company (null = system)
  createdBy   String?  @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")


  @@index([isGlobal])
  @@index([category])
  @@index([companyId])
  @@map("tbl_skill_templates")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AgentConfigurationPreset {

  id               String   @id @default(uuid())
  name             String
  description      String?
  config           Json // Full agent configuration preset
  specializationId String?  @map("specialization_id")
  isDefault        Boolean  @default(false) @map("is_default")
  isGlobal         Boolean  @default(false) @map("is_global")
  companyId        String?  @map("company_id")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  specialization AgentSpecialization? @relation(fields: [specializationId], references: [id], onDelete: Cascade)

  @@index([specializationId])
  @@index([companyId])
  @@index([isGlobal])
  @@map("tbl_agent_configuration_presets")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AssetAnnotation {

  id        String        @id @default(uuid())
  assetId   String        @map("asset_id")
  authorId  String        @map("author_id")
  content   String
  xPercent  Float         @map("x_percent")
  yPercent  Float         @map("y_percent")
  status    String        @default("OPEN")
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  @@index([assetId])
  @@index([authorId])
  @@map("tbl_asset_annotations")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AssetCollection {

  id          String                @id @default(uuid())
  name        String
  description String?
  companyId   String                @map("company_id")
  createdById String                @map("created_by_id")
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  items       AssetCollectionItem[]

  @@index([companyId])
  @@map("tbl_asset_collections")
  schemaVersion Int @default(0) @map("col_schema_version")
  deletedAt DateTime? @map("col_deleted_at")
}

model AssetCollectionItem {

  id           String          @id @default(uuid())
  collectionId String          @map("collection_id")
  assetId      String          @map("asset_id")
  order        Int             @default(0)
  addedAt      DateTime        @default(now()) @map("added_at")
  collection   AssetCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([collectionId, assetId])
  @@index([collectionId])
