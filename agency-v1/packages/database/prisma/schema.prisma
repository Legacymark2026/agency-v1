generator client {
  provider = "prisma-client-js"
  col_output = "../node_modules/@prisma/client/core"
  previewFeatures = ["postgresqlExtensions"]
}

col_datasource db {
  col_provider = "postgresql"
  col_url = env("POSTGRES_EXTERNAL_URL")
  col_extensions = [vector]
}

col_model tbl_tbl_user {
  col_id String                    @id @default(uuid())
  col_name String?
  col_email String?                   @unique
  col_emailVerified DateTime?                 @map("email_verified")
  col_image String?
  col_passwordHash String?                   @map("password_hash")
  col_firstName String?                   @map("first_name")
  col_lastName String?                   @map("last_name")
  col_phone String?
  col_role String                    @default("guest")
  col_mfaEnabled Boolean                   @default(false) @map("mfa_enabled")
  col_mfaSecret String?                   @map("mfa_secret")
  col_createdAt DateTime                  @default(now()) @map("created_at")
  col_updatedAt DateTime                  @updatedAt @map("updated_at")
  col_deactivatedAt DateTime?                 @map("deactivated_at")
  col_adminNotes String?                   @map("admin_notes")
  col_backupCodes Json?                     @map("backup_codes")
  col_customTag String?                   @map("custom_tag")
  col_jobTitle String?                   @map("job_title")
  col_globalRole String                    @default("client_user") @map("global_role")
  col_accounts Account[]
  col_agentConversations AgentConversation[]
  col_annotations Annotation[]
  col_apiKeys ApiKey[]
  col_assetAnnotations AssetAnnotation[]
  col_assetCollections AssetCollection[]
  col_assetVersions AssetVersion[]
  col_claimedBounties Bounty[]                  @relation("BountyClaimer")
  col_createdBounties Bounty[]                  @relation("BountyCreator")
  col_approvedCampaigns Campaign[]                @relation("ApprovedCampaigns")
  col_commissionPayments CommissionPayment[]       @relation("UserCommissionPayments")
  col_commissionRules CommissionRule[]          @relation("UserCommissionRules")
  col_invitedUsers CompanyUser[]             @relation("InvitedBy")
  col_companies CompanyUser[]
  col_assignedConversations Conversation[]
  col_crmActivities CRMActivity[]
  col_stageHistoryChanges DealStageHistory[]        @relation("StageHistoryUser")
  col_assignedDeals Deal[]                    @relation("AssignedDeals")
  col_eventParticipations EventParticipant[]
  col_organizedEvents Event[]                   @relation("EventOrganizer")
  col_approvedExpenses Expense[]                 @relation("ExpenseApprover")
  col_createdExpenses Expense[]                 @relation("ExpenseCreator")
  col_kanbanAnnotations KanbanAssetAnnotation[]   @relation("AnnotationAuthor")
  col_kanbanAuditLogs KanbanAuditLog[]          @relation("KanbanAuditActor")
  col_kanbanComments KanbanComment[]           @relation("KanbanCommentAuthor")
  col_kanbanSubtasks KanbanSubtask[]           @relation("KanbanSubtaskCreator")
  col_assignedKanbanTasks KanbanTask[]              @relation("KanbanTaskAssignee")
  col_createdKanbanTasks KanbanTask[]              @relation("KanbanTaskCreator")
  col_marketingEvents MarketingEvent[]
  NotificationDeliveryLog NotificationDeliveryLog[]
  Notification            Notification[]
  col_payrollAuditLogs PayrollAuditLog[]         @relation("PayrollAuditor")
  col_posts Post[]
  col_proposals Proposal[]
  col_readingList ReadingListItem[]
  col_resourcePermissions ResourcePermission[]
  col_inboxAuditLogs InboxAuditLog[]
  col_salesGoals SalesGoal[]               @relation("UserSalesGoals")
  col_sessions Session[]
  col_socialPostComments SocialPostComment[]
  col_socialPostLogs SocialPostLog[]
  col_approvedSocialPosts SocialPost[]              @relation("SocialPostApprover")
  col_socialPosts SocialPost[]              @relation("SocialPostAuthor")
  col_assignedTasks Task[]                    @relation("TaskAssignee")
  col_createdTasks Task[]                    @relation("TaskCreator")
  col_timeEntries TimeEntry[]
  col_approvedTimeOffs TimeOffRequest[]          @relation("TimeOffApprover")
  col_approvedTimesheets Timesheet[]               @relation("TimesheetApprover")
  col_activityLogs UserActivityLog[]
  col_profile UserProfile?
  col_aiauditLogs AIAuditLog[]
  col_agentMemories AgentMemory[]

  @@index([role])
  @@index([email])
  @@index([globalRole])
  @@map("tbl_tbl_tbl_tbl_tbl_tbl_tbl_tbl_tbl_users")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_role_config {
  col_id String   @id @default(uuid())
  col_roleName String   @unique @map("role_name")
  col_allowedRoutes Json     @default("[]") @map("allowed_routes")
  col_description String?
  col_isActive Boolean  @default(true) @map("is_active")
  col_createdAt DateTime @default(now()) @map("created_at")
  col_updatedAt DateTime @updatedAt @map("updated_at")

  @@index([roleName])
  @@map("role_configs")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_permission {
  col_id String           @id @default(uuid())
  col_name String           @unique
  col_module String
  col_description String?
  col_isActive Boolean          @default(true) @map("is_active")
  col_createdAt DateTime         @default(now()) @map("created_at")
  col_updatedAt DateTime         @updatedAt @map("updated_at")
  col_rolePermissions RolePermission[]

  @@index([module])
  @@map("permissions")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_role {
  col_id String           @id @default(uuid())
  col_companyId String           @map("company_id")
  col_name String
  col_description String?
  col_isDefault Boolean          @default(false) @map("is_default")
  col_isActive Boolean          @default(true) @map("is_active")
  col_priority Int              @default(0)
  col_createdAt DateTime         @default(now()) @map("created_at")
  col_updatedAt DateTime         @updatedAt @map("updated_at")
  col_users CompanyUser[]
  col_permissions RolePermission[]
  col_company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_role_permission {
  col_id String     @id @default(uuid())
  col_roleId String     @map("role_id")
  col_permissionId String     @map("permission_id")
  col_createdAt DateTime   @default(now()) @map("created_at")
  col_permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  col_role Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_resource_permission {
  col_id String   @id @default(uuid())
  col_userId String   @map("user_id")
  col_companyId String   @map("company_id")
  col_resourceType String
  col_resourceId String   @map("resource_id")
  col_permission String
  col_access Boolean  @default(true)
  col_createdAt DateTime @default(now()) @map("created_at")
  col_updatedAt DateTime @updatedAt @map("updated_at")
  col_company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  col_user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId, resourceType, resourceId, permission])
  @@index([userId, companyId])
  @@index([resourceType, resourceId])
  @@map("resource_permissions")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_password_reset_token {
  col_id String   @id @default(cuid())
  col_email String
  col_token String   @unique
  col_expiresAt DateTime
  col_used Boolean  @default(false)
  col_createdAt DateTime @default(now()) @map("created_at")

  @@index([email])
  @@index([token])
  @@map("password_reset_tokens")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_user_profile {
  col_id String  @id @default(uuid())
  col_userId String  @unique @map("user_id")
  col_jobTitle String? @map("job_title")
  col_department String?
  col_bio String?
  col_socialLinks Json?   @default("{
  col_schema_version Int @default(1)
}") @map("social_links")
  col_preferences Json?   @default("{\"theme\": \"system\", \"notifications\": {\"email\": true}}")
  col_metadata Json?   @default("{}")
  col_googleAnalytics Json?   @map("google_analytics_config")
  col_facebookPixel Json?   @map("facebook_pixel_config")
  col_googleTagManager Json?   @map("google_tag_manager_config")
  col_hotjar Json?   @map("hotjar_config")
  col_user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profiles")
}

col_model tbl_tbl_account {
  col_id String  @id @default(uuid())
  col_userId String  @map("user_id")
  col_type String
  col_provider String
  col_providerAccountId String  @map("provider_account_id")
  col_refresh_token String?
  col_access_token String?
  col_expires_at Int?
  col_token_type String?
  col_scope String?
  col_id_token String?
  col_session_state String?
  col_user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_session {
  col_id String   @id @default(uuid())
  col_sessionToken String   @unique @map("session_token")
  col_userId String   @map("user_id")
  col_expires DateTime
  col_ipAddress String?  @map("ip_address")
  col_userAgent String?  @map("user_agent")
  col_user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_verification_token {
  col_identifier String
  col_token String   @unique
  col_expires DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_company {
  col_id String                     @id @default(uuid())
  col_name String
  col_slug String                     @unique
  col_logoUrl String?                    @map("logo_url")
  col_industry String?
  col_website String?
  col_subscriptionTier String                     @default("free") @map("subscription_tier")
  col_subscriptionStatus String                     @default("active") @map("subscription_status")
  col_onboardingCompleted Boolean                    @default(false) @map("onboarding_completed")
  col_createdAt DateTime                   @default(now()) @map("created_at")
  col_defaultCompanySettings Json?                      @map("default_settings")
  col_passwordPolicy Json?                      @map("password_policy")
  col_stripeCustomerId String?                    @map("stripe_customer_id")
  col_stripeSubscriptionId String?                    @map("stripe_subscription_id")
  col_whiteLabeling Json?                      @map("white_labeling")
  col_customObjectDefinitions CustomObjectDefinition[]
  col_whatsappIntegrations WhatsAppIntegration[]
  col_emailDomainVerifications EmailDomainVerification[]
  col_abTests ABTest[]
  col_adSpends AdSpend[]
  col_agentConfig AgentConfig?
  col_agentConversations AgentConversation[]
  col_aiAgents AIAgent[]
  col_apiKeys ApiKey[]
  col_assetCollections AssetCollection[]
  col_brandKit BrandKit?
  col_campaignAssets CampaignAsset[]
  col_campaignRules CampaignRule[]
  col_campaigns Campaign[]
  col_commissionPayments CommissionPayment[]
  col_commissionRules CommissionRule[]
  col_members CompanyUser[]
  col_conversations Conversation[]
  col_automationRules DealAutomationRule[]
  col_deals Deal[]
  col_emailSequences EmailSequence[]
  col_emailTemplates EmailTemplate[]
  col_employeeBenefits EmployeeBenefit[]
  col_employees Employee[]
  col_events Event[]
  col_expenseCategories ExpenseCategory[]
  col_expenses Expense[]
  col_experiments Experiment[]
  col_financialAccounts FinancialAccount[]
  col_inboxMacros InboxMacro[]
  col_inboxAuditLogs InboxAuditLog[]
  col_integrationConfigs IntegrationConfig[]
  col_integrationLogs IntegrationLog[]
  col_invoices Invoice[]
  col_kanbanProjects KanbanProject[]
  col_knowledgeBases KnowledgeBase[]
  col_scoringRules LeadScoringRule[]
  col_leads Lead[]
  col_marketingEvents MarketingEvent[]
  NotificationDeliveryLog   NotificationDeliveryLog[]
  col_notificationPrefs NotificationPreference[]
  Notification              Notification[]
  col_payrolls Payroll[]
  col_proposals Proposal[]
  col_resourcePermissions ResourcePermission[]
  col_roles Role[]
  col_salesGoals SalesGoal[]
  col_servicePrices ServicePrice[]
  col_shortLinks ShortLink[]
  col_socialPosts SocialPost[]
  col_tasks Task[]
  col_teams Team[]
  col_usageLogs UsageLog[]
  col_webhooks Webhook[]
  col_workflows Workflow[]
  col_videoEditorProjects VideoEditorProject[]
  col_agentSpecializations AgentSpecialization[]
  col_agentSkills AgentSkill[]
  col_skillTemplates SkillTemplate[]
  col_agentConfigurationPresets AgentConfigurationPreset[]
  col_mlWeights MLCompanyWeights[]
  col_aiauditLogs AIAuditLog[]
  col_agentMemories AgentMemory[]
  col_agentSkillChains AgentSkillChain[]
  col_agentTeams AgentTeam[]
  col_agentTeamRuns AgentTeamRun[]

  @@map("companies")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_service_price {
  col_id String   @id @default(uuid())
  col_companyId String   @map("company_id")
  col_codigo_id String?  @map("codigo_id")
  col_nombre_servicio String
  col_categoria String
  col_tipo_formato String?  @map("tipo_formato")
  col_tiempo_estimado String?  @map("tiempo_estimado")
  col_herramientas String?
  col_descripcion String
  col_precio_base Float
  col_iva_porcentaje Float    @default(19.0)
  col_retefuente_porc Float    @default(11.0)
  col_reteiva_porc Float    @default(2.85)
  col_ica_porc Float    @default(0.6)
  col_precio_urgente Float?
  col_isExpress Boolean  @default(false)
  col_estado String   @default("activo")
  col_orderIndex Int      @default(0) @map("order_index")
  col_createdAt DateTime @default(now()) @map("created_at")
  col_updatedAt DateTime @updatedAt @map("updated_at")
  col_ica_valor Float?   @default(0) @map("ica_valor")
  col_iva_valor Float?   @default(0) @map("iva_valor")
  col_retefuente_valor Float?   @default(0) @map("retefuente_valor")
  col_reteiva_valor Float?   @default(0) @map("reteiva_valor")
  col_subtotal Float?   @default(0)
  col_company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@map("service_prices")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_brand_kit {
  col_id String   @id @default(uuid())
  col_companyId String   @unique @map("company_id")
  col_name String   @default("Brand Kit")
  col_primaryColor String   @default("#6D28D9") @map("primary_color")
  col_secondaryColor String   @default("#FFFFFF") @map("secondary_color")
  col_accentColor String   @default("#10B981") @map("accent_color")
  col_logoUrl String?  @map("logo_url")
  col_fontFamily String   @default("Inter") @map("font_family")
  col_toneOfVoice String   @default("professional") @map("tone_of_voice")
  col_brandValues String[] @map("brand_values")
  col_targetAudience String?  @map("target_audience")
  col_createdAt DateTime @default(now()) @map("created_at")
  col_updatedAt DateTime @updatedAt @map("updated_at")
  col_company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("brand_kits")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_company_user {
  col_id String   @id @default(uuid())
  col_userId String   @map("user_id")
  col_companyId String   @map("company_id")
  col_permissions Json?    @default("[]")
  col_invitedBy String?  @map("invited_by")
  col_joinedAt DateTime @default(now()) @map("joined_at")
  col_teamId String?  @map("team_id")
  col_phoneExtension String?  @map("phone_extension")
  col_roleId String?  @map("role_id")
  col_roleName String   @default("member") @map("role_name")
  col_company Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  col_inviter User?    @relation("InvitedBy", fields: [invitedBy], references: [id])
  col_role Role?    @relation(fields: [roleId], references: [id])
  col_team Team?    @relation(fields: [teamId], references: [id])
  col_user User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([roleName])
  @@index([roleId])
  @@map("company_users")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_team {
  col_id String                   @id @default(uuid())
  col_name String
  col_description String?
  col_path String                   @default("/")
  col_level Int                      @default(0)
  col_parentId String?                  @map("parent_id")
  col_companyId String                   @map("company_id")
  col_createdAt DateTime                 @default(now()) @map("created_at")
  col_updatedAt DateTime                 @updatedAt @map("updated_at")
  col_maxHeadcount Int?                     @map("max_headcount")
  col_monthlyBudget Float?                   @map("monthly_budget")
  col_permissions CustomObjectPermission[]
  col_bounties Bounty[]
  col_members CompanyUser[]
  col_company Company                  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  col_parent Team?                    @relation("TeamHierarchy", fields: [parentId], references: [id])
  col_children Team[]                   @relation("TeamHierarchy")

  @@index([companyId])
  @@index([path])
  @@map("teams")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_custom_object_definition {
  col_id String                     @id @default(cuid())
  col_name String
  col_label String
  col_description String?
  col_companyId String
  col_createdAt DateTime                   @default(now())
  col_updatedAt DateTime                   @updatedAt
  col_company Company                    @relation(fields: [companyId], references: [id])
  col_fields CustomObjectField[]
  col_permissions CustomObjectPermission[]
  col_relationshipsFrom CustomObjectRelationship[] @relation("RelationshipFrom")
  col_relationshipsTo CustomObjectRelationship[] @relation("RelationshipTo")
  col_records CustomObjectRecord[]

  @@unique([companyId, name])

  col_schema_version Int @default(1)
}

col_model tbl_tbl_custom_object_field {
  col_id String                 @id @default(cuid())
  col_name String
  col_label String
  col_type String
  col_required Boolean                @default(false)
  col_options String?
  col_definitionId String
  col_createdAt DateTime               @default(now())
  col_updatedAt DateTime               @updatedAt
  col_definition CustomObjectDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  col_schema_version Int @default(1)
}

col_model tbl_tbl_custom_object_relationship {
  col_id String                 @id @default(cuid())
  col_name String
  col_type String
  col_fromId String
  col_toId String
  col_createdAt DateTime               @default(now())
  col_updatedAt DateTime               @updatedAt
  col_from CustomObjectDefinition @relation("RelationshipFrom", fields: [fromId], references: [id], onDelete: Cascade)
  col_to CustomObjectDefinition @relation("RelationshipTo", fields: [toId], references: [id], onDelete: Cascade)

  col_schema_version Int @default(1)
}

col_model tbl_tbl_custom_object_permission {
  col_id String                 @id @default(cuid())
  col_teamId String
  col_definitionId String
  col_canCreate Boolean                @default(false)
  col_canRead Boolean                @default(false)
  col_canUpdate Boolean                @default(false)
  col_canDelete Boolean                @default(false)
  col_definition CustomObjectDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  col_team Team                   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, definitionId])

  col_schema_version Int @default(1)
}

col_model tbl_tbl_custom_object_record {
  col_id String                 @id @default(uuid())
  col_definitionId String                 @map("definition_id")
  col_data col_json col_createdBy String?                @map("created_by")
  col_createdAt DateTime               @default(now()) @map("created_at")
  col_updatedAt DateTime               @updatedAt @map("updated_at")
  col_definition CustomObjectDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)

  @@index([definitionId])
  @@map("custom_object_records")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_user_activity_log {
  col_id String   @id @default(uuid())
  col_userId String?  @map("user_id")
  col_action String
  col_details Json?
  col_ipAddress String?  @map("ip_address")
  col_userAgent String?  @map("user_agent")
  col_createdAt DateTime @default(now()) @map("created_at")
  col_user User?    @relation(fields: [userId], references: [id])

  @@map("user_activity_logs")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_api_key {
  col_id String    @id @default(uuid())
  col_name String
  col_keyHash String    @unique @map("key_hash")
  col_userId String?   @map("user_id")
  col_companyId String?   @map("company_id")
  col_isActive Boolean   @default(true) @map("is_active")
  col_createdAt DateTime  @default(now()) @map("created_at")
  col_createdBy String?   @map("created_by")
  col_expiresAt DateTime? @map("expires_at")
  col_lastUsedAt DateTime? @map("last_used_at")
  col_prefix String?   @map("prefix")
  col_scopes String[]  @default([])
  col_company Company?  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  col_user User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("api_keys")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_post {
  col_id String      @id @default(uuid())
  col_title String
  col_slug String      @unique
  col_excerpt String?
  col_content String
  col_coverImage String?     @map("cover_image")
  col_imageAlt String?     @map("image_alt")
  col_published Boolean     @default(false)
  col_metaTitle String?     @map("meta_title")
  col_metaDescription String?     @map("meta_description")
  col_canonicalUrl String?     @map("canonical_url")
  col_focusKeyword String?     @map("focus_keyword")
  col_status String      @default("draft")
  col_scheduledDate DateTime?   @map("scheduled_date")
  col_authorId String      @map("author_id")
  col_seriesId String?     @map("series_id")
  col_seriesOrder Int?        @map("series_order")
  col_createdAt DateTime    @default(now()) @map("created_at")
  col_updatedAt DateTime    @updatedAt @map("updated_at")
  col_categories Category[]
  col_tags Tag[]
  col_comments Comment[]
  col_likes PostLike[]
  col_views PostView[]
  col_author User        @relation(fields: [authorId], references: [id])
  col_series PostSeries? @relation(fields: [seriesId], references: [id])
  col_faqs Json?       @default("[]")

  @@index([authorId])
  @@index([seriesId])
  @@map("posts")

  col_schema_version Int @default(1)
}

col_model tbl_tbl_project {
  col_id String                @id @default(uuid())
  col_title String
  col_slug String                @unique
  col_description String
  col_content String?
  col_client String?
  col_coverImage String?               @map("cover_image")
  col_imageAlt String?               @map("image_alt")
  col_gallery Json?                 @default("[]")
  col_published Boolean               @default(false)
  col_metaTitle String?               @map("meta_title")
  col_metaDescription String?               @map("meta_description")
  col_focusKeyword String?               @map("focus_keyword")
  col_status String                @default("draft")
  col_scheduledDate DateTime?             @map("scheduled_date")
  col_featured Boolean               @default(false)
  col_displayOrder Int                   @default(0) @map("display_order")
  col_startDate DateTime?             @map("start_date")
  col_endDate DateTime?             @map("end_date")
  col_testimonial String?
  col_results Json?                 @default("[]")
  col_projectUrl String?               @map("project_url")
  col_categoryId String?               @map("category_id")
  col_createdAt DateTime              @default(now()) @map("created_at")
  col_updatedAt DateTime              @updatedAt @map("updated_at")
  col_clientLogo String?               @map("client_logo")
  col_pdfUrl String?               @map("pdf_url")
  col_private Boolean               @default(false)
  col_seoScore Int                   @default(0)
  col_team Json?                 @default("[]")
  col_techStack Json?                 @default("[]")
  col_videoUrl String?               @map("video_url")
  ProjectToProjectTag ProjectToProjectTag[]
  ProjectToService    ProjectToService[]
  col_views ProjectView[]
  col_category ProjectCategory?      @relation(fields: [categoryId], references: [id])

