{
  "name": "@agency/database",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "generate": "prisma generate --schema=./prisma/schema.prisma",
    "generate:auth": "prisma generate --schema=./prisma/schema.auth.prisma",
    "generate:core": "prisma generate --schema=./prisma/schema.core.prisma",
    "generate:media": "prisma generate --schema=./prisma/schema.media.prisma",
    "generate:analytics": "prisma generate --schema=./prisma/schema.analytics.prisma",
    "generate:all": "npm run generate:auth && npm run generate:core && npm run generate:media && npm run generate:analytics",
    "migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema=./prisma/schema.prisma",
    "db:push": "prisma db push --schema=./prisma/schema.prisma",
    "studio": "prisma studio --schema=./prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "prisma": "^6.19.3",
    "typescript": "^5"
  }
}
