{
  "name": "legacymark-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "generate-structure": "node scripts/generate-structure.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "k8s:dev": "kubectl apply -k infrastructure/k8s/overlays/dev",
    "k8s:staging": "kubectl apply -k infrastructure/k8s/overlays/staging",
    "k8s:prod": "kubectl apply -k infrastructure/k8s/overlays/production",
    "db:generate": "npm run generate --workspace=packages/database",
    "db:migrate": "npm run migrate:deploy --workspace=packages/database",
    "db:studio": "npm run studio --workspace=packages/database",
    "doctor": "npx react-doctor --project web --full --verbose"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "puppeteer": "^24.43.0",
    "puppeteer-cluster": "^0.25.0"
  }
}
