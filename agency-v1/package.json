{
  "name": "legacymark-monorepo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "test:coverage": "turbo test:coverage",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "generate-structure": "node scripts/generate-structure.js",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:build": "docker compose build",
    "docker:logs": "docker compose logs -f",
    "k8s:dev": "kubectl apply -k infrastructure/k8s/overlays/dev",
    "k8s:staging": "kubectl apply -k infrastructure/k8s/overlays/staging",
    "k8s:prod": "kubectl apply -k infrastructure/k8s/overlays/production",
    "db:generate": "npm run generate --workspace=packages/database && npx prisma generate --schema=apps/coffee-web/prisma/schema.prisma",
    "db:migrate": "npm run migrate:deploy --workspace=packages/database",
    "db:migrate:segregated": "node scripts/migrate-segregated-dbs.js",
    "db:sync-schemas": "node scripts/sync-prisma-schemas.js",
    "db:studio": "npm run studio --workspace=packages/database",
    "doctor": "npx react-doctor --project web --full --verbose",
    "test:infrastructure": "npx tsx tests/infrastructure.test.ts",
    "test:contracts": "npx tsx tests/contracts.test.ts",
    "test:performance": "npx tsx tests/performance.test.ts",
    "test:chaos": "npx tsx tests/chaos.test.ts",
    "test:security": "npx tsx tests/security.test.ts",
    "test:services": "npm run test --workspaces --if-present",
    "test:all-suites": "npm run test:infrastructure && npm run test:contracts && npm run test:performance && npm run test:chaos && npm run test:security && npm run test:services"
  },
  "packageManager": "npm@10.8.2",
  "devDependencies": {
    "turbo": "^2.0.0"
  },
  "dependencies": {
    "puppeteer": "^24.43.0",
    "puppeteer-cluster": "^0.25.0",
    "tsconfig-paths": "^4.2.0"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "^0.28.0",
    "@rollup/rollup-linux-x64-gnu": "*",
    "@rollup/rollup-linux-x64-musl": "*"
  }
}
