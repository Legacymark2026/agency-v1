generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model AdminUser {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Post {
  id          String   @id @default(uuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String
  category    String   @default("Estrategia")
  authorName  String
  authorRole  String
  imageUrl    String
  readTime    String   @default("5 min de lectura")
  published   Boolean  @default(true)
  viewsCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  path       String
  referrer   String?
  userAgent  String?
  deviceType String   @default("desktop")
  eventType  String   @default("pageview")
  metadata   String?
  createdAt  DateTime @default(now())

  @@index([eventType])
  @@index([createdAt])
  @@index([path])
}

model ChatConversation {
  id             String        @id @default(uuid())
  visitorName    String        @default("Visitante Web")
  visitorContact String?
  status         String        @default("nuevo") // nuevo, en_atencion, respondido, cerrado
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  lastMessageAt  DateTime      @default(now())
  messages       ChatMessage[]

  @@index([status])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String           @default("visitor") // visitor, admin
  text           String
  createdAt      DateTime         @default(now())

  @@index([conversationId])
}
